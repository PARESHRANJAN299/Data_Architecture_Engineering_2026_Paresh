{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lca/contracts/target-silver-event/1-0-0",
  "title": "LCA Target Silver Market Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_source",
    "schema_name",
    "schema_version",
    "source_event_time",
    "ingestion_time",
    "partition_key",
    "classification",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
    "event_type": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
    "event_source": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
    "schema_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_event_time": { "type": "string", "format": "date-time" },
    "ingestion_time": { "type": "string", "format": "date-time" },
    "partition_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": { "type": "string" },
        "producer_version": { "type": "string" },
        "aws_region": { "type": "string" }
      }
    },
    "payload": { "type": "object" }
  }
}
